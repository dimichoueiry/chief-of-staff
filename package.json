{
  "name": "chief-of-staff",
  "version": "0.1.0",
  "description": "A chief of staff for one person: remembers every commitment you made to yourself and speaks first every morning.",
  "type": "module",
  "private": true,
  "bin": {
    "cos": "./dist/cli/cos.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "cos": "tsx src/cli/cos.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "package": "npm run build && tsx src/cli/cos.ts menubar package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/mcp": "^0.0.81",
    "commander": "^15.0.0",
    "openai": "^7.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}

# ---- Models: add a key for any provider you want to use (one is enough) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Any OpenAI-compatible server, e.g. Ollama: http://localhost:11434/v1
COS_COMPATIBLE_BASE_URL=
COS_COMPATIBLE_API_KEY=
COS_COMPATIBLE_MODEL=
# Set to 1 if that server supports response_format json_schema
COS_COMPATIBLE_JSON_SCHEMA=

# Fallback model as provider:model. `cos models use ...` and the menubar Model menu override it.
# Examples: anthropic:claude-opus-5 · openai:gpt-5.4 · openrouter:openai/gpt-5.2 · compatible:llama3.2
COS_MODEL=
# Reasoning depth where supported: low | medium | high
COS_EFFORT=

# ---- Voice ----
# OPENAI_API_KEY above also gives the natural voice (gpt-4o-mini-tts). Without it, the Mac voice speaks.
# Change these any time with `cos voice`; these are only starting values.
# COS_TTS=auto            # auto | openai | say
# COS_TTS_VOICE=marin     # alloy ash ballad coral echo sage shimmer verse marin cedar

# ---- Memory and personal settings ----
# Where your memory lives (a git repo of markdown). Defaults to ~/selfhub
COS_SELFHUB=
# Folders scanned for git activity (colon-separated). Defaults to ~/Desktop
COS_PROJECT_ROOTS=
# Your first name, used in greetings
COS_NAME=
# Where Slate lives, if not the deployed app (e.g. http://localhost:5173)
# COS_SLATE_URL=https://slate-iota-lac.vercel.app
# Calendar days the assistant always has in mind, starting today (1-31, default 7). Any other range is looked up on request.
# COS_CALENDAR_DAYS=7
# Minutes of quiet before the pill starts a new conversation (default 120). ＋ new or ⌘N starts one any time.
# COS_CONVERSATION_IDLE_MINUTES=120
# Agent Grid, if you'd rather not use the file it writes to ~/.agentgrid/web.json (the URL it prints, with ?t=)
# AGENTGRID_URL=http://127.0.0.1:8787/?t=...

# Required for any command that talks to the model (brief, focus, capture, ask, wrap)
ANTHROPIC_API_KEY=

# Optional overrides
# Where your memory lives (a git repo of markdown). Defaults to ~/selfhub
COS_SELFHUB=
# Model to use. Defaults to claude-opus-5
COS_MODEL=
# Folders scanned for git activity (colon-separated). Defaults to ~/Desktop
COS_PROJECT_ROOTS=
# Your first name, used in greetings
COS_NAME=
